rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatMember(chatId) {
      return signedIn()
        && chatExists(chatId)
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    function chatCreator(chatId) {
      return signedIn()
        && chatExists(chatId)
        && get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.createdBy == request.auth.uid;
    }

    // Direct-chat access is denied if either side has blocked the other.
    function directChatAllowed(chatId) {
      let c = get(/databases/$(database)/documents/chats/$(chatId)).data;
      let otherUid = c.participants[0] == request.auth.uid
        ? c.participants[1]
        : c.participants[0];
      return c.type == "group"
        || (request.auth.uid in c.participants
          && !(otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blockedUsers)
          && !(request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.blockedUsers));
    }

    function directUsersAllowed(otherUid) {
      return signedIn()
        && !(otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blockedUsers)
        && !(request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.blockedUsers);
    }

    /* ================= USERS ================= */

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }

    /* ================= CHATS ================= */

    match /chats/{chatId} {
      allow read: if chatMember(chatId) && directChatAllowed(chatId);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && (
          request.resource.data.type == "group"
          || (
            request.resource.data.type == "direct"
            && request.resource.data.participants.size() == 2
            && directUsersAllowed(
              request.resource.data.participants[0] == request.auth.uid
                ? request.resource.data.participants[1]
                : request.resource.data.participants[0]
            )
          )
        );

      allow update: if chatMember(chatId) && directChatAllowed(chatId);

      allow delete: if chatCreator(chatId);

      match /messages/{messageId} {
        allow read: if chatMember(chatId) && directChatAllowed(chatId);

        allow create: if chatMember(chatId)
          && directChatAllowed(chatId)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if chatMember(chatId)
          && directChatAllowed(chatId)
          && (
            resource.data.senderId == request.auth.uid
            ||
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'delivered',
                'seen',
                'deletedFor'
              ])
          );

        allow delete: if chatMember(chatId)
          && directChatAllowed(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    /* ================= GROUP INDEX ================= */

    match /groupIndex/{groupId} {
      allow read: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && (
          (resource.data.participants is list
            && request.auth.uid in resource.data.participants)
          ||
          (request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants)
        );

      allow delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          ||
          request.auth.uid in resource.data.admins
        );
    }

    /* ================= VOICE / VIDEO CALLS ================= */

    match /calls/{callId} {

      /*
       * Caller creates the call.
       * The call document contains callerId + calleeId.
       */
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ['voice', 'video']
        && directUsersAllowed(request.resource.data.calleeId);

      /*
       * Caller and callee can receive the call document.
       * This also allows the incoming-call query:
       * where("calleeId", "==", currentUser.uid)
       */
      allow read: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && directUsersAllowed(
          resource.data.callerId == request.auth.uid
            ? resource.data.calleeId
            : resource.data.callerId
        );

      /*
       * Caller/callee can update call status,
       * answer, acceptedAt, endedAt, etc.
       */
      allow update: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && directUsersAllowed(
          resource.data.callerId == request.auth.uid
            ? resource.data.calleeId
            : resource.data.callerId
        );

      allow delete: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      /* ---------- ICE candidates ---------- */

      /*
       * Both sides need to READ the remote candidate collection.
       * Only the matching side may WRITE its own candidates.
       */

      match /callerCandidates/{candidateId} {
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            ||
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          )
          && directUsersAllowed(
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              ? get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
              : get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          );

        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;

        allow update, delete: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            ||
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          )
          && directUsersAllowed(
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              ? get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
              : get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          );

        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;

        allow update, delete: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    /* ================= REPORTS ================= */

    match /reports/{reportId} {
      // Users may submit reports about other users, but cannot read reports.
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid;
      allow read, update, delete: if false;
    }

    /* ================= DEFAULT DENY ================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
