rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipantFromResource() {
      return signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // User profiles
    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Direct and group chat documents
    match /chats/{chatId} {

      // Existing chat: only participants can read it.
      allow get: if isParticipantFromResource();

      // A new chat can be created by a signed-in participant.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants;

      // Existing participants may update chat metadata/typing,
      // but may not replace the participant list.
      allow update: if isParticipantFromResource()
        && request.resource.data.participants == resource.data.participants;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isParticipantFromResource();

        allow create: if isParticipantFromResource()
          && request.resource.data.senderId == request.auth.uid;

        allow update: if isParticipantFromResource()
          && (
            request.resource.data.senderId == resource.data.senderId
            || (
              request.resource.data.senderId == resource.data.senderId
              && request.resource.data.seen == true
            )
            || (
              request.resource.data.senderId == resource.data.senderId
              && request.resource.data.delivered == true
            )
          );

        allow delete: if isParticipantFromResource()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /groupIndex/{groupId} {
      allow get, list: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
