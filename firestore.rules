rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isParticipant(chatId) {
      return signedIn()
        && request.auth.uid in chatData(chatId).participants;
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isUser(userId);

      allow update: if isUser(userId);

      allow delete: if isUser(userId);
    }

    // Direct and group chats
    match /chats/{chatId} {
      allow read: if isParticipant(chatId);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(chatId)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;

      // Messages inside a chat
      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if isParticipant(chatId)
          && (
            request.resource.data.senderId == resource.data.senderId
            || request.resource.data.seen == true
            || request.resource.data.delivered == true
          );

        allow delete: if isParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Group index used for the user's group list
    match /groupIndex/{groupId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;
    }
  }
}
